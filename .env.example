# recall — all local, nothing leaves your machine.
#
# NOTE: recall does not load this file. It documents the environment variables
# the daemon, hooks, and CLIs read from the actual process environment. Set
# them system-wide (e.g. `setx` on Windows) if you need non-defaults — the
# daemon is spawned detached and inherits whatever env Claude Code had.

# Where the SQLite DB lives. Cursor cache/token/config live beside it.
# RECALL_DB_PATH=~/.recall/memory.db

# Local daemon port.
# RECALL_PORT=4319

# Daemon bind address. Default 127.0.0.1. Set 0.0.0.0 to allow LAN/Tailscale
# clients — non-localhost requests then require the bearer token from
# ~/.recall/token.
# RECALL_BIND=127.0.0.1

# Embedding model (transformers.js id). 384-dim default.
# RECALL_MODEL=Xenova/bge-small-en-v1.5

# Master switch for auto-inject. Set to false to disable injection instantly.
# RECALL_ENABLED=true

# Minimum cosine similarity (0..1) for a snippet to be auto-injected by the
# prompt hook. Conservative on purpose: weak-to-mid scores read as noise.
# RECALL_MIN_SCORE=0.75

# Minimum similarity for the daemon's /ask short-answer endpoint.
# RECALL_ASK_MIN_SCORE=0.45

# Project roots: map cwd subtrees to one project label, so many subfolders
# share a memory bucket. Semicolon-separated `path=label` pairs. Also
# configurable in ~/.recall/config.json ({"projectRoots":[{root,label}]}).
# RECALL_PROJECT_ROOTS=C:/Users/you/Projects=projects;C:/Users/you/work=work

# Set to 1 for daemon request logging (metadata only, never content).
# RECALL_DEBUG=1

# Comma-separated cwd substrings whose sessions prune-noise treats as junk.
# RECALL_PRUNE_CWD=
